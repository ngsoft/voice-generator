{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "platform-check": false
  },
  "autoload": {
    "psr-4": {
      "": ["src/"]
    },
    "files": ["lib/libs-pdo-php82.php", "src/functions.php"]
  },
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "afaya/edge-tts": "^1.7",
    "league/mime-type-detection": "^1",
    "ngsoft/cli-profile": "^26",
    "ngsoft/container": "^3",
    "ngsoft/php-vite-adapter": "^1.0",
    "ngsoft/routing": "^1",
    "ramsey/uuid": "^4",
    "symfony/cache": "^7",
    "symfony/config": "^7",
    "symfony/console": "^7",
    "symfony/dotenv": "^7",
    "symfony/http-foundation": "^7",
    "symfony/http-kernel": "^7",
    "symfony/process": "^7",
    "symfony/translation": "^7",
    "symfony/yaml": "^7",
    "zircote/swagger-php": "^6.0"
  },
  "require-dev": {
    "phan/phan": "^5",
    "symfony/var-dumper": "^7",
    "friendsofphp/php-cs-fixer": "^3",
    "jetbrains/phpstorm-attributes": "dev-master"
  }
}
