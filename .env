# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       uncommitted environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
APP_ENV=dev
APP_DEBUG=false
APP_ID=speech
APP_LANG=en
APP_LANG_FORCED=
APP_TITLE="Speech Synthesis"
APP_DESCRIPTION="Speech Synthesis API"
APP_VERSION=2026.03.0
# DB Connection
DATABASE_URL=[]
DATABASE_URL_0="mysql://root:toor@127.0.0.1:3306/${APP_ID}"
#DATABASE_URL_SQLITE="sqlite:%data%/${APP_ID}.sqlite"
DATABASE_URL_SQLITE="sqlite:%data%/db.sqlite"
# CORS
CORS_ENABLE=false
CORS_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
# API KEY
API_KEY=
# ACL
GLOBAL_ACL=
LOCAL_ACL=
WEB_ACL=
# TTS FILE AUTO REMOVAL
SPEECH_SYNTHESIS_TTL=60
#Lang filter
LANG_FILTER=
# TTS CLIENTS
ELEVEN_API_KEY=

# VITE
APP_VITE_ENDPOINTS='["app/app.css","app/app.ts"]'
# VITE ENV VARS
VITE_APP_TITLE="${APP_TITLE}"
VITE_APP_ID="${APP_ID}"
