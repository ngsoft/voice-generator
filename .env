# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       uncommitted environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
APP_ENV=dev
APP_DEBUG=false
APP_ID=app
APP_LANG=en
APP_LANG_FORCED=
APP_TITLE=
APP_DESCRIPTION=
# DB Connection
DATABASE_URL=[]
DATABASE_URL_0="mysql://loic:Hevmix03@127.0.0.1:3306/${APP_ID}"
DATABASE_URL_1="mysql://root:toor@127.0.0.1:3306/${APP_ID}"
#DATABASE_URL_SQLITE="sqlite:%data%/${APP_ID}.sqlite"
DATABASE_URL_SQLITE="sqlite:%data%/db.sqlite"
# CORS
CORS_ENABLE=false
CORS_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
# API KEY
API_KEY=
# VITE
APP_VITE_ENDPOINTS='["app/app.css","app/app.ts"]'
# VITE ENV VARS
# 'catppuccin'|'cerberus'|'concord'|'crimson'|'fennec'|'hamlindigo'|'legacy'|'mint'|'modern'|'mona'|'nosh'|'nouveau'|'pine'|'reign'|'rocket'|'rose'|'sahara'|'seafoam'|'terminus'|'vintage'|'vox'|'wintry'
VITE_SKELETON_THEME="terminus"
# 'acid'|'autumn'|'bumblebee'|'caramellatte'|'cmyk'|'corporate'|'cupcake'|'cyberpunk'|'emerald'|'fantasy'|'garden'|'lemonade'|'light'|'lofi'|'nord'|'pastel'|'retro'|'silk'|'valentine'|'winter'|'wireframe'
VITE_DAIZY_UI_THEME_LIGHT="winter"
# 'dark'|'dracula'|'synthwave'|'halloween'|'forest'|'black'|'luxury'|'night'|'coffee'|'sunset'|'abyss'|'business'|'dim'|'aqua'
VITE_DAIZY_UI_THEME_DARK="forest"
VITE_APP_TITLE="${APP_TITLE}"
VITE_APP_ID="${APP_ID}"
