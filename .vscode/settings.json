{
  "editor.formatOnSave": true,
  "[php]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.codeActionsOnSave": {
      "source.action.useSortedAttributes.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "html.format.wrapLineLength": 120,
  "html.format.extraLiners": "",
  "[svelte]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.codeActionsOnSave": {
      "source.action.useSortedAttributes.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.format.config.printWidth": 150,
  "svelte.plugin.svelte.format.config.singleQuote": true,
  "svelte.plugin.svelte.defaultScriptLanguage": "ts",
  "svelte.plugin.svelte.format.config.svelteBracketNewLine": false,
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.action.useSortedKeys.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.action.useSortedKeys.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.action.useSortedProperties.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "typescript": "typescript",
    "Svelte": "svelte",
    "html": "HTML"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.eol": "\n",
  "tailwindCSS.emmetCompletions": true,
  "tailwind-fold.foldStyle": "QUOTES",
  "tailwind-fold.unfoldIfLineSelected": true,
  "tailwind-fold.foldLengthThreshold": 64,
  "tailwind-fold.autoFold": true,
  "prettier.enable": false,
  "eslint.enable": false,
  "eslint.format.enable": false,
  "biome.suggestInstallingGlobally": true,
  "inline-bookmarks.view.showVisibleFilesOnly": false,
  "prettier.bracketSameLine": true,
  "biome.enabled": true
}
