# Configuration du client Go de « bin/console speak ».
#
# Les fichiers suivants sont chargés s'ils existent, le dernier ayant priorité :
#
#  * .env                  valeurs par défaut, versionnées
#  * .env.local            surcharges locales, non versionnées
#  * .env.$VOICE_ENV       défauts propres à un environnement, non versionnés
#  * .env.$VOICE_ENV.local surcharges propres à un environnement, non versionnées
#
# Les variables réellement présentes dans l'environnement gagnent sur ces fichiers,
# et les options passées en Go ou en drapeau de la CLI gagnent sur l'environnement.
#
# Tout ce qui est défini ici est hérité par le sous-processus php : d'où VOICE_ENV
# plutôt qu'APP_ENV, qui a sa propre signification côté PHP.
#
# Un speak.json posé à côté de l'exécutable surcharge tout ce qui suit
# (voir speak.json.dist).
#
# NE PAS METTRE DE SECRET DE PRODUCTION DANS CE FICHIER NI DANS AUCUN FICHIER VERSIONNÉ.
VOICE_ENV=dev

# Répertoire où chercher ces fichiers .env ; vide = répertoire courant puis
# répertoire de l'exécutable.
VOICE_ENV_DIR=

# Interpréteur PHP. Vide : PHP_BINARY puis php.exe / php dans le PATH.
VOICE_PHP_BIN=

# Script bin/console. Vide : remontée arborescente à la recherche d'un couple
# bin/console + composer.json.
VOICE_CONSOLE_PATH=

# Répertoire de travail du sous-processus. Vide : racine du projet, dont dépend
# le chemin relatif bin/console utilisé par la commande pour se relancer sous WSL.
VOICE_WORKING_DIR=

# Arguments insérés avant le script, par exemple : -d memory_limit=512M
VOICE_PHP_ARGS=

# Valeurs par défaut de l'énoncé, alignées sur SpeakCommand::configure().
VOICE_LANG=en-US
VOICE_VOICE=en-US-AvaMultilingualNeural

# Durée maximale d'exécution (30s, 2m…). Vide ou 0 : illimitée.
VOICE_TIMEOUT=

# Verbosité de la commande PHP : quiet, normal, v, vv, vvv.
VOICE_VERBOSITY=normal

# Ajoute --no-ansi, utile quand la sortie est journalisée.
VOICE_NO_ANSI=false

# Autorise les questions interactives ; false ajoute --no-interaction.
VOICE_INTERACTIVE=false
